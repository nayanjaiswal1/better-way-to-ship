#!/usr/bin/env sh
# Strip AI agent attribution lines before commitlint validation.
# Removes lines matching: Co-Authored-By: Claude/Copilot/ChatGPT/Gemini,
# "Generated by ...", "🤖 Generated with ...", "via Claude Code", etc.
MSG_FILE="$1"
sed -i \
  -e '/[Cc]o-[Aa]uthored-[Bb]y:.*[Cc]laude/d' \
  -e '/[Cc]o-[Aa]uthored-[Bb]y:.*[Cc]opilot/d' \
  -e '/[Cc]o-[Aa]uthored-[Bb]y:.*[Cc]hat[Gg][Pp][Tt]/d' \
  -e '/[Cc]o-[Aa]uthored-[Bb]y:.*[Gg]emini/d' \
  -e '/[Gg]enerated with.*[Cc]laude/d' \
  -e '/[Gg]enerated by.*[Cc]laude/d' \
  -e '/via [Cc]laude [Cc]ode/d' \
  -e '/🤖/d' \
  -e '/noreply@anthropic\.com/d' \
  "$MSG_FILE"

pnpm commitlint --edit "$MSG_FILE"
